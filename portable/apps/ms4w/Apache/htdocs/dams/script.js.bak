function initMap()
{
	console.info("Leaflet library loaded");
	
	// Center coordinates (longitude, latitude)
	var trier = {lng: 6.675, lat: 49.748};
	
	// Create Map Object (Constructor)
	var map = L.map
	(
		document.getElementById("map-container"),
		{
			center: trier,
			zoom: 10
		}
	);
	
	// Add Open Street Map background layer
	var osmLayer = L.tileLayer
	(
		"http://{s}.tile.osm.org/{z}/{x}/{y}.png",
		{
			attribution: "Thank You <a href='http://osm.org/copyright'>OpenStreetMap</a>!"	
		}
	);
	
	map.addLayer(osmLayer);
	
	// Create custom WMS layer
	var customLayer = L.tileLayer.wms
	(
		// Map file parameter is relative to mapserv.exe location
		"http://localhost:8800/cgi-bin/mapserv.exe?map=../htdocs/wms/data/rlp_og.map",
		{
				layers: "Grenzen",
				format: "image/png",
				transparent: true
		}
	);
	
	map.addLayer(customLayer);
	
	// Create external WMS layer
	var wmsLayer = L.tileLayer.wms
	(
		"https://geodaten.naturschutz.rlp.de/kartendienste_naturschutz/mod_ogc/wms_getmap.php?mapfile=wms_naturschutz_rlp",
		{
			layers: "naturschutzgebiet",
			format: "image/png",
			transparent: true
		}
	);
	
	map.addLayer(wmsLayer);
	
	// Create marker
	var marker = L.marker
	(
		trier,
		{
			title: "Campus II"
		}
	);
	
	map.addLayer(marker);
};

// Main entry point (no Callback function needed)
initMap();